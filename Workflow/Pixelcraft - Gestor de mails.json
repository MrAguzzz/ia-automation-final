        "responses": {
          "values": [
            {
              "role": "system",
              "content": "Sos el sistema de clasificación de emails de PixelCraft Studio.\n\nTu tarea es analizar emails recibidos por la agencia y clasificarlos.\n\nDebés determinar:\n\n1. Categoría\n2. Prioridad\n3. Intención del cliente\n4. Resumen breve del mensaje\n\nLas categorías permitidas son únicamente:\n- Consulta comercial\n- Presupuesto\n- Soporte\n- Reclamo\n- Otro\n\nLas prioridades permitidas son únicamente:\n- Baja\n- Media\n- Alta\n\nNo inventes información que no esté presente en el email.\n\nDevolvé únicamente un JSON válido con esta estructura:\n\n{\n  \"categoria\": \"\",\n  \"prioridad\": \"\",\n  \"intencion\": \"\",\n  \"resumen\": \"\""
            },
            {
              "content": "=Analizá este email:\n\nRemitente:\n{{$json.fields.Cliente}}\n\nAsunto:\n{{$json.fields.Asunto}}\n\nMensaje:\n{{$json.fields.Mensaje}}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "schema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"categoria\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Consulta comercial\",\n        \"Presupuesto\",\n        \"Soporte\",\n        \"Reclamo\",\n        \"Otro\"\n      ]\n    },\n    \"prioridad\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Baja\",\n        \"Media\",\n        \"Alta\"\n      ]\n    },\n    \"intencion\": {\n      \"type\": \"string\"\n    },\n    \"resumen\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"categoria\",\n    \"prioridad\",\n    \"intencion\",\n    \"resumen\"\n  ],\n  \"additionalProperties\": false\n}"
            }
          }
        }
      },
